# Copie ce fichier en ".env" (même dossier) et remplis tes propres valeurs.
# .env est déjà exclu par .gitignore — il ne sera jamais poussé sur GitHub.

# --- MongoDB ---
# Option A (local, recommandé pour la démo) :
MONGO_URI=mongodb://localhost:27017
# Option B (MongoDB Atlas, cloud gratuit) :
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_DB_NAME=geif_reclamations

# --- Sécurité ---
JWT_SECRET=change-moi-en-une-longue-chaine-aleatoire
JWT_EXPIRATION_MINUTES=120

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- CORS (mets l'URL exacte de ton frontend en prod, "*" en démo) ---
ALLOWED_ORIGINS=*

# --- Apprentissage ---
EXPLORATION_EPSILON=0.05

# --- Email (SMTP réel — envoi de la décision au contribuable) ---
# Exemple Gmail : crée un "mot de passe d'application" sur
# myaccount.google.com/apppasswords (le mot de passe normal ne marche pas).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=DGI — GEIF (Espace Contribuable)

# --- Codes d'inscription par rôle (donne-les toi-même aux chefs) ---
CODE_CHEF_SECTEUR=SECTEUR-2026
CODE_CHEF_SUBDIVISION=SUBDIVISION-2026

# --- OCR (Tesseract) ---
# Chemin complet vers tesseract.exe après installation (laisse vide si Tesseract est dans le PATH) :
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGS=fra+ara
