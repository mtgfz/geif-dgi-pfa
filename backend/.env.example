# =====================================================================
# GEIF — variables d'environnement.  Copier en "backend/.env" (ignoré par git).
# =====================================================================

# --- Base de données ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=geif_reclamations

# --- JWT ---   (générer : python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120

# --- LLM Groq (https://console.groq.com) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Codes d'inscription des comptes internes ---
# Un code VIDE pour un chef = inscription désactivée pour ce rôle (sécurité).
# CODE_GESTIONNAIRE vide = inscription libre pour les gestionnaires (à éviter en production).
CODE_GESTIONNAIRE=
CODE_CHEF_SERVICE=
CODE_CHEF_SUBDIVISION=

# --- OCR (Tesseract) ---
# Windows : TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe   (détecté automatiquement si installé au chemin par défaut)
TESSERACT_CMD=
# Langues demandées ; si une manque (ex : ara) l'OCR continue avec les autres.
OCR_LANGS=fra+ara
# Dossier optionnel de fichiers .traineddata (défaut : backend/tessdata)
TESSDATA_LOCAL=
# 1 = forcer Tesseract même sur les PDF qui contiennent déjà du texte
OCR_FORCER=0
# Diagnostic :  cd backend && python -m app.ocr

# --- E-mail (SMTP) — optionnel ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- CORS : origines du frontend, séparées par des virgules ---
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500
