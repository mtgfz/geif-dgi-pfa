# =====================================================================
# GEIF — configuration pour Docker.   Copier en « .env » à la racine :
#     Linux/Mac : cp .env.example .env        Windows : copy .env.example .env
# (le fichier .env est ignoré par git : ne jamais publier de clé)
# =====================================================================

# Clé de signature des connexions. Générer :  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Modèle de langage (https://console.groq.com). Sans clé : textes de repli fondés sur les règles.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Codes demandés à l'inscription d'un compte agent. Vide pour un chef = inscription désactivée pour ce rôle.
CODE_GESTIONNAIRE=
CODE_CHEF_SERVICE=
CODE_CHEF_SUBDIVISION=

# Langues de l'OCR (fra et ara sont installées dans l'image)
OCR_LANGS=fra+ara

# E-mail : laisser vide pour utiliser Mailpit (http://localhost:8025), ou renseigner un vrai serveur SMTP.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
